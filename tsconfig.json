{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true,
    "paths": {
      "@pages/*": ["pages/*"],
      "@interfaces/*": ["interfaces/*"],
      "@data/*": ["data/*"],
      "@helpers/*": ["helpers/*"]
    }
  },
  "include": ["tests/**/*.ts", "*.ts", "pages/**/*.ts", "interfaces/**/*.ts", "data/**/*.ts", "helpers/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
